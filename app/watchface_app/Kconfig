# For a description of the syntax of this configuration file,
# see the file kconfig-language.txt in the NuttX tools repository.
#

menuconfig EXAMPLES_WATCHFACE
	tristate "HuangshanPi Watchface"
	default n
	depends on GRAPHICS_LVGL
	---help---
		Multi-face watch UI (Classic / Mickey / Digital / Sport) with
		swipe navigation and a long-press face picker.

if EXAMPLES_WATCHFACE

config EXAMPLES_WATCHFACE_PRIORITY
	int "watchface task priority"
	default 100

config EXAMPLES_WATCHFACE_STACKSIZE
	int "watchface stack size"
	default 65536

endif # EXAMPLES_WATCHFACE
